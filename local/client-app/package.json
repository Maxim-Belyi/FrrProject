{
	"name": "frontend-template",
	"type": "module",
	"version": "3.0.0",
	"private": true,
	"engineStrict": true,
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite",
		"build-no-lint": "time vite build",
		"build": "time npm run lint && vite build",
		"watch": "vite build --watch",
		"build-initial": "npm run lint && vite build -m initial",
		"preview": "npm run lint && vite build -m initial && vite preview",
		"deploy-layout": "dotenv -- sh -c 'time npm run lint && vite build -m deploy && time rsync -az --delete --progress dist/ html.xpager.ru@html.xpager.ru:/srv/www/html.xpager.ru/htdocs/public/$VITE_APP_NAME'",
		"svgo": "svgo ./src/**/*.svg",
		"lint": "eslint --fix && vue-tsc --noEmit && stylelint . --fix"
	},
	"dependencies": {
		"@popperjs/core": "2.11.8",
		"@vueform/multiselect": "2.6.11",
		"@vueform/slider": "2.1.10",
		"@vueform/toggle": "2.1.4",
		"@vuelidate/core": "2.0.3",
		"@vuelidate/validators": "2.0.4",
		"@vuepic/vue-datepicker": "11.0.2",
		"@vueuse/core": "12.8.2",
		"@vueuse/integrations": "12.8.2",
		"axios": "^1.9.0",
		"floating-vue": "5.2.2",
		"lodash": "4.17.21",
		"maska": "3.1.1",
		"pinia": "3.0.2",
		"swiper": "11.2.6",
		"universal-cookie": "7.2.2",
		"vue": "3.5.13",
		"vue-router": "4.5.0",
		"vue-toastification": "2.0.0-rc.5",
		"vue-yandex-maps": "^2.1.7"
	},
	"devDependencies": {
		"@antfu/eslint-config": "4.12.0",
		"@spiriit/vite-plugin-svg-spritemap": "3.0.1",
		"@stylistic/stylelint-config": "2.0.0",
		"@types/lodash": "4.17.16",
		"@types/node": "22.14.0",
		"@types/pug": "2.0.10",
		"@vitejs/plugin-vue": "5.2.3",
		"@vituum/vite-plugin-juice": "1.3.0",
		"autoprefixer": "10.4.21",
		"dotenv-cli": "8.0.0",
		"eslint": "9.24.0",
		"lightningcss": "1.29.3",
		"postcss": "8.5.3",
		"postcss-functions": "4.0.2",
		"postcss-html": "1.8.0",
		"postcss-pxtorem": "6.1.0",
		"postcss-sass": "0.5.0",
		"postcss-short": "5.0.0",
		"pug": "3.0.3",
		"sass-embedded": "1.86.3",
		"stylelint": "16.12.0",
		"stylelint-config-html": "1.1.0",
		"stylelint-config-recommended-scss": "14.1.0",
		"stylelint-config-recommended-vue": "1.6.0",
		"stylelint-order": "6.0.4",
		"sugarss": "5.0.0",
		"svgo": "3.3.2",
		"terser": "5.39.0",
		"typescript": "5.8.3",
		"unplugin-fonts": "1.3.1",
		"vite": "^6.3.5",
		"vue-tsc": "2.2.8"
	},
	"browserslist": [
		">1%",
		"not op_mini all",
		"not ie 11",
		"last 3 chrome version",
		"last 3 firefox version",
		"last 3 safari version"
	]
}
