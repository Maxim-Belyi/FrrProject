extends /base/_head
block vars
	- let title = 'Новости'
	- let layoutClass = 'layout'
	- let bodyClass = null

block content
	+header({})

	main.page__main
		+page-header({title: 'Команда', breadcrumbs: ['Главная', 'Команда']})
			+slot('actions')
				nav.tabs
					ul.tabs__list
						li.tabs__item
							a(href="#").tab.tab--default.active Команда региона
						li.tabs__item
							a(href="#").tab.tab--default Проектная команда
						li.tabs__item
							a(href="#").tab.tab--default Партнеры и инвесторы

		include ../templates/command/command

	include ../templates/shared/footer
