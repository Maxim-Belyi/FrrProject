extends /base/_head
block vars
	- let title = 'Видео'
	- let layoutClass = 'layout'
	- let bodyClass = null

block content
	+header({})

	main.page__main
		+page-header({title: 'Медиа', breadcrumbs: ['Главная', 'Медиа']})
			+slot('actions')
				nav.tabs
					ul.tabs__list
						li.tabs__item
							a(href="#").tab.tab--default Новости
						li.tabs__item
							a(href="#").tab.tab--default Фото
						li.tabs__item
							a(href="#").tab.tab--default.active Видео

		include ../templates/media/videos

	include ../templates/shared/footer
