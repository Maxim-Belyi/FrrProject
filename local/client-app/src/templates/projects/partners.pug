			.section__content
				section-slider(id="partners-slider" :space-between="0" :breakpoints="{ 1: { slidesPerView: 1.3 }, 481: { slidesPerView: 2.3 }, 769: { slidesPerView: 4 }, 1441: { slidesPerView: 6 } }").partners-slider__slider
