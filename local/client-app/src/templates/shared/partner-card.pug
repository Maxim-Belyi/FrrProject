mixin partner-card(data)
	article.partner-card(@click="openModal('modal-partner-projects', 1)")&attributes(attributes)
		.partner-card__preview
			+image(
				{
					src: data.img,
					width: '100',
					height: '100',
					lazy: true,
					alt: 'alt'
				}
			).partner-card__image

		.partner-card__desc
			.partner-card__title.title.title--h5!=data.title
			.partner-card__caption.text!=data.caption
