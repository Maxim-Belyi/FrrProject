		.album__list
			each item, i in gallerySlides
				+image(
					{
						src: item.src,
						width: '620',
						height: '400',
						lazy: true
					}
				).album__item(@click=`openGalleryModal('gallery-album', ${i})`)

modal-gallery(id="gallery-album" title="Заголовок альбома" :slides=gallerySlides)
