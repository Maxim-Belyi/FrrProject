section.page__section.section.main-about
	.wrapper
		.main-about__wrapper

			.main-about__bg
				+image(
					{
						src: 'img/content/main/regional-map.webp',
						width: '1158',
						height: '760',
					}
				).main-about__bg-image
			.main-about__top
				.main-about__achievements.achievements
					.achievements__item.achievements__item--full
						.achievements__value.title.title--h1 10 000 000 000 ₽
						.achievements__title Объем инвестиций, привлеченных в проекты развития
					.achievements__item
						.achievements__value.title.title--h2 2
						.achievements__title Реализуемых мастер-плана и программы развития
					.achievements__item
						.achievements__value.title.title--h2 24
						.achievements__title Опорных населенных пункта в фокусе методологического центра

				.main-about__block
					.main-about__block-title.title.title--h4 Опорные населенные пункты (ОНП) — это ключевые населенные пункты, которые играют важную роль в социально-экономическом развитии региона. Они могут служить центрами для предоставления различных услуг, таких как образование, здравоохранение, торговля и транспорт. Опорные населенные пункты выбираются на основе их стратегического положения, инфраструктуры и потенциала для развития.
					a(href="#").main-about__block-btn.btn.btn--color-secondary
						span.btn__text Подробнее
						+icon('arrow-right-up').btn__icon

				.main-about__block
					.main-about__block-title.title.title--h4 Мастер-планы представляют собой стратегические документы, которые определяют долгосрочные цели и направления развития городов и муниципальных образований. Они разрабатываются с целью улучшения качества жизни населения, повышения экономической активности и устойчивого развития территорий.
					a(href="#").main-about__block-btn.btn.btn--color-secondary
						span.btn__text Подробнее
						+icon('arrow-right-up').btn__icon

			.main-about__bottom
				.main-about__banner
					.main-about__banner-wrapper
						.main-about__banner-title.title.title--h5 Изучите карту, чтобы узнать больше о развитии каждого города.
						.main-about__banner-btn.btn.btn--color-primary Интерактивная карта
